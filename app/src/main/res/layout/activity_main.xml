<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Top Accessible Header Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_surface"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/accessible_gold"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/app_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_active_bg"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/status_active"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Camera Preview Viewport -->
    <com.example.objectdetection.CameraSourcePreview
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:contentDescription="@string/cd_camera_preview"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@+id/control_sheet"/>

    <com.example.objectdetection.GraphicOverlay
        android:id="@+id/graphic_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="@id/preview_view"
        app:layout_constraintRight_toRightOf="@id/preview_view"
        app:layout_constraintTop_toTopOf="@id/preview_view"
        app:layout_constraintBottom_toBottomOf="@id/preview_view"/>

    <!-- Bottom Accessible Controls Sheet -->
    <LinearLayout
        android:id="@+id/control_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_surface"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quick_controls_title"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_controls_subtitle"
                android:textColor="#FFA0A0A0"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Scrollable Flex / Grid Container for Current & Future Toggles -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/toggles_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Audio Alert Toggle -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/audio_toggle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                    android:layout_width="120dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/audio_alert_on"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_volume_up"
                    app:iconSize="22dp"
                    app:iconTint="@color/white"
                    app:strokeColor="@color/accessible_gold"
                    app:strokeWidth="2dp" />

                <!-- Vibration Alert Toggle -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/vibration_toggle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                    android:layout_width="120dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/vibe_alert_on"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_vibration"
                    app:iconSize="22dp"
                    app:iconTint="@color/white"
                    app:strokeColor="@color/accessible_gold"
                    app:strokeWidth="2dp" />

                <!-- Flashlight / Torch Toggle -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/torch_toggle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                    android:layout_width="120dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/torch_off"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_flash_off"
                    app:iconSize="22dp"
                    app:iconTint="@color/white"
                    app:strokeColor="@color/accessible_outline"
                    app:strokeWidth="1dp" />

                <!-- Camera Direction Switch -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/facing_switch"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                    android:layout_width="120dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/camera_back"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_switch_camera"
                    app:iconSize="22dp"
                    app:iconTint="@color/white"
                    app:strokeColor="@color/white"
                    app:strokeWidth="1dp" />

                <!-- Gemini AI Inference Mode Toggle -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/inference_toggle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                    android:layout_width="120dp"
                    android:layout_height="60dp"
                    android:text="@string/inference_off"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_ai"
                    app:iconSize="22dp"
                    app:iconTint="@color/white"
                    app:strokeColor="@color/accessible_outline"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
