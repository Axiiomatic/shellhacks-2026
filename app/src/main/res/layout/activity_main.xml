<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Camera Preview Viewport (Behind Overlay) -->
    <com.example.objectdetection.CameraSourcePreview
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:contentDescription="@string/cd_camera_preview"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <com.example.objectdetection.GraphicOverlay
        android:id="@+id/graphic_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="@id/preview_view"
        app:layout_constraintRight_toRightOf="@id/preview_view"
        app:layout_constraintTop_toTopOf="@id/preview_view"
        app:layout_constraintBottom_toBottomOf="@id/preview_view"/>

    <!-- Top Accessible Header Bar (Floating Overlay) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_surface"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/cd_app_title" />

            <TextView
                android:id="@+id/app_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_active_bg"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/status_active"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom Sliding Card Overlay (Draggable Up & Down) -->
    <LinearLayout
        android:id="@+id/control_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp"
        android:elevation="16dp"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Simple, Big Up/Down Toggle Header Container -->
        <LinearLayout
            android:id="@+id/control_toggle_btn"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/quick_controls_btn_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_header_toggle">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quick_controls_label"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/control_toggle_arrow"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/black"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Vertical Scrollable Container for Huge Accessible Buttons -->
        <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/toggles_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true">

                <!-- Row 1: Audio & Vibration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <FrameLayout
                        android:id="@+id/audio_toggle"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/quick_controls_btn_bg"
                        android:backgroundTint="@color/pastel_yellow"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/cd_audio_on">

                        <ImageView
                            android:id="@+id/audio_icon"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_volume_up"
                            app:tint="@color/black"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/vibration_toggle"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/quick_controls_btn_bg"
                        android:backgroundTint="@color/pastel_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/cd_vibe_on">

                        <ImageView
                            android:id="@+id/vibration_icon"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_vibration"
                            app:tint="@color/black"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Row 2: Torch & Inference -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/torch_toggle"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/quick_controls_btn_bg"
                        android:backgroundTint="@color/dark_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/cd_torch_off">

                        <ImageView
                            android:id="@+id/torch_icon"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_flash_off"
                            app:tint="@color/pastel_peach"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/inference_toggle"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/quick_controls_btn_bg"
                        android:backgroundTint="@color/dark_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/cd_inference_off">

                        <ImageView
                            android:id="@+id/inference_icon"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_ai"
                            app:tint="@color/pastel_lavender"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
